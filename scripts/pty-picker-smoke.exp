#!/usr/bin/expect -f

set timeout 5

if {![info exists env(DGO_BIN)]} {
    puts stderr "DGO_BIN is required"
    exit 2
}

set sandbox "/tmp/dirgo-pty-[pid]-[clock seconds]"
set fixture_root "$sandbox/filesystem"
file mkdir "$fixture_root/Archive/api"
file mkdir "$fixture_root/Services/api"
for {set index 0} {$index < 30} {incr index} {
    set entry [format "content-%02d" $index]
    set handle [open "$fixture_root/Archive/api/$entry" w]
    close $handle
}
file mkdir "$sandbox/config/dirgo"
set config [open "$sandbox/config/dirgo/config.toml" w]
puts $config "schema_version = 1"
puts $config "roots = \[\"$fixture_root\"\]"
close $config

set env(XDG_CONFIG_HOME) "$sandbox/config"
set env(XDG_CACHE_HOME) "$sandbox/cache"
set env(XDG_STATE_HOME) "$sandbox/state"
set env(TERM) "xterm-256color"
set env(DGO_TUI_FULLSCREEN) 1
spawn -noecho /bin/sh -c {stty rows 24 columns 100; exec "$DGO_BIN" query no-such-directory}

expect {
    -exact "Finding directories" {}
    eof {
        set result [wait]
        file delete -force $sandbox
        exit [lindex $result 3]
    }
    timeout {
        puts stderr "picker did not render"
        file delete -force $sandbox
        exit 4
    }
}
send -- "\025api"
expect {
    -exact "Archive" {}
    timeout {
        puts stderr "live query did not produce both matches"
        file delete -force $sandbox
        exit 5
    }
}
expect {
    -exact "Services" {}
    timeout {
        puts stderr "live query did not produce both matches"
        file delete -force $sandbox
        exit 5
    }
}
expect {
    -exact "content-00" {}
    timeout {
        puts stderr "directory preview did not load"
        file delete -force $sandbox
        exit 6
    }
}
for {set index 0} {$index < 40} {incr index} {
    send -- "\033\[1;2B"
}
send -- "\t\t"
expect {
    -exact "content-29" {}
    timeout {
        puts stderr "directory preview did not scroll to the final entry"
        file delete -force $sandbox
        exit 7
    }
}
for {set index 0} {$index < 40} {incr index} {
    send -- "\033\[1;2A"
}
send -- "\t\t"
expect {
    -exact "content-00" {}
    timeout {
        puts stderr "Shift-Up did not scroll the directory preview back"
        file delete -force $sandbox
        exit 8
    }
}
send -- "\r"
expect -exact "$fixture_root/Archive/api"
expect eof
set result [wait]
file delete -force $sandbox
exit [lindex $result 3]
